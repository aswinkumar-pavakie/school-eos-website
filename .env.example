# Base URL of the School EOS backend API (NestJS service)
NEXT_PUBLIC_API_BASE_URL=

# Base URL of the separate School EOS Messaging microservice (E2EE messaging)
MESSAGING_API_BASE_URL=

# Base URL of the separate AI assistant bot service (school-eos-ai-bot).
# Server-only (no NEXT_PUBLIC_ prefix) -- proxied through src/app/api/ai-chat/route.ts
# so the real URL never reaches the browser.
AI_BOT_BASE_URL=
